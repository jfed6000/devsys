# make_rma : makefile to compile the new 6309-compatible "rma"

#SDIR = ...
#ODIR = build/os9
PROG = las
ODIR = . 
RDIR = build/os9
OBJS = rma_main.r findcmd.r part3.r registers.r directives.r labels.r \
   numeric.r file_io.r macros.r symtab.r module.r lwobj.r preload.r

PROTOS = rma_main.c findcmd.c part3.c registers.c directives.c labels.c \
   numeric.c file_io.c macros.c symtab.c module.c lwobj.c preload.c

CFLAGS = -dCOCO
LFLAGS = -l=/dd/lib/clib.l -o=las
CC = cc

# This file will be named "r63", following the 68xxx - type modules

$(PROG): $(OBJS) rma.h
    chd $(RDIR);rlink /dd/lib/cstart.r $(OBJS) $(LFLAGS) -o=./$(PROG) -m -s >-symbols;chd ...

rma_main.r findcmd.r part3.r registers.r directives.r labels.r file_io.r macros.r symtab.r module.r lwobj.r preload.r:
    $(CC) $(CFLAGS) $*.c -r=$(RDIR) -s

numeric.r:
    $(CC) $(CFLAGS) numeric.c -r=$(RDIR)

rma_main.r: rma.h rtables.h

proto.h: $(PROTOS)
    echo >proto.h
    cproto $(PROTOS) -o proto.z
	mv proto.z proto.h

clean:
 del r63 *.r
