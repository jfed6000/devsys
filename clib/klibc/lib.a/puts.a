********** puts_a **********

 ifp1
 use ../defs/stdio.a
 endc
 psect puts_a,0,0,1,0,0

*** puts(s)
*    put null term. string to std out adding '\n'
*    no return, no error
*    stack   s
*           ret
*            u
*            fp
*        ->  *s (or c)

puts: pshs u
 leax _iob+13,y stdout fp
 ldd 4,s *s
 pshs d,x stack *s,fp
 bsr fputs
 ldb #$0d CR ('\n')
 stb 1,s
 lbsr putc
 leas 4,s
 puls u,pc


*** fputs(s,fp)
*    puts null term. string to fp
*    no error, no return
*    stack    fp
*             s
*            ret
*        ->   u

fputs: pshs u
 ldu 4,s *s
 ldx 6,s get fp
* devsys (step 28): while putc would only store (its first test, see
* putc.a), copy straight into the buffer, leaving the last byte for
* putc so that it flushes; the rest goes through putc as before
 ldd _flag,x
 anda #_INIT+_WRITTEN
 andb #_ERR+_SCF+_WRITE+_UNBUF
 cmpa #_INIT+_WRITTEN
 bne fputs0
 cmpb #_WRITE
 bne fputs0
 ldd _end,x
 subd #1
 pshs d the last byte
 ldx _ptr,x
fputs3 ldb ,u
 beq fputs4
 cmpx ,s
 bhs fputs4
 leau 1,u
 stb ,x+
 bra fputs3
fputs4 leas 2,s
 tfr x,d
 ldx 6,s fp
 std _ptr,x
fputs0 pshs d,x stack fp and make space
 bra fputs1

fputs2 stb 1,s stack char
 lbsr putc
fputs1 ldb ,u+
 bne fputs2
 leas 4,s clean off c and fp
 puls u,pc

 endsect
